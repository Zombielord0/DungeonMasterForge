{
  "name": "dungeon-masters-forge",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/portal.js --bundle --format=esm --target=es2020 --minify --outfile=public/portal.js",
    "test": "node --test test/*.test.mjs",
    "test:all": "node tools/test-all.mjs",
    "dev": "esbuild src/portal.js --bundle --format=esm --alias:@netlify/identity=./test/e2e/fake-identity.js --outfile=.dev/portal-test.js --log-level=warning && node test/e2e/server.mjs .dev/portal-test.js 8899",
    "test:map": "node test/e2e/map-fog.cjs",
    "test:backup": "node test/e2e/backup.cjs",
    "test:tv": "node test/e2e/tv.cjs",
    "test:mapvis": "node test/e2e/map-visuals.cjs",
    "test:mapio": "node test/e2e/map-import.cjs",
    "test:shop": "node test/e2e/shop.cjs",
    "test:random": "node test/e2e/random-enc.cjs",
    "test:cards": "node test/e2e/spell-cards.cjs",
    "test:mapenc": "node test/e2e/map-enc.cjs",
    "test:calendar": "node test/e2e/calendar.cjs",
    "test:recap": "node test/e2e/recap.cjs",
    "test:sheet": "node test/e2e/sheet-maths.cjs",
    "test:tokens": "node test/e2e/tokens.cjs",
    "test:npcpic": "node test/e2e/npc-pictures.cjs",
    "test:hbspell": "node test/e2e/homebrew-spells.cjs",
    "test:hbpend": "node test/e2e/hb-pending.cjs",
    "test:import": "node test/e2e/char-import.cjs",
    "test:layout": "node test/e2e/layout.cjs",
    "test:lore": "node test/e2e/lore.cjs",
    "test:mythweaver": "node test/e2e/mythweaver.cjs",
    "test:campextras": "node test/e2e/camp-extras.cjs",
    "test:npclib": "node test/e2e/npc-lib.cjs",
    "test:world": "node test/e2e/world.cjs",
    "test:setup": "node test/e2e/setup-screen.cjs"
  },
  "dependencies": {
    "@netlify/database": "^2.0.3",
    "@netlify/functions": "^6.1.1",
    "@netlify/identity": "^2.0.1"
  },
  "devDependencies": {
    "@netlify/database-dev": "^1.0.2",
    "esbuild": "^0.28.2",
    "pg": "^8.13.0"
  }
}
